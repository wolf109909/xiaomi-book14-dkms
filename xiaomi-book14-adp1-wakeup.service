[Unit]
Description=Disable Xiaomi Book Pro 14 AC-adapter wakeup
Wants=systemd-udev-settle.service
After=systemd-udev-settle.service
ConditionPathExists=/sys/class/power_supply/ADP1/power/wakeup

[Service]
Type=oneshot
ExecStart=/bin/sh -c 'printf disabled > /sys/class/power_supply/ADP1/power/wakeup; for f in /sys/class/power_supply/ucsi-source-psy-*/power/wakeup; do [ -e "$f" ] && printf disabled > "$f"; done'
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
