post_install() {
    dkms add -m xiaomi-book14 -v 1.2.0
    dkms install -m xiaomi-book14 -v 1.2.0
    systemctl daemon-reload
    systemctl enable --now xiaomi-book14-adp1-wakeup.service 2>/dev/null || true
    echo "==> xiaomi-book14 installed. Load now with: sudo modprobe xiaomi-book14"
    echo "==> (bitland_mifs_wmi/redmi_wmi are blacklisted by this package)"
}

post_upgrade() {
    dkms install -m xiaomi-book14 -v 1.2.0
    systemctl daemon-reload
    systemctl enable --now xiaomi-book14-adp1-wakeup.service 2>/dev/null || true
}

pre_upgrade() {
    dkms remove -m xiaomi-book14 -v 1.2.0 --all 2>/dev/null || true
}

pre_remove() {
    systemctl disable --now xiaomi-book14-adp1-wakeup.service 2>/dev/null || true
    dkms remove -m xiaomi-book14 -v 1.2.0 --all 2>/dev/null || true
}
